{
  "name": "🛰️ Echoes Lost in Orbit | 🟢 Beginner (Broken Echoes)",
  "image": "mcr.microsoft.com/devcontainers/base:bullseye",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/adventures/echoes-lost-in-orbit/beginner",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "bash /workspaces/${localWorkspaceFolderBasename}/.devcontainer/echoes-lost-in-orbit_beginner/post-create.sh",
  "postStartCommand": "bash /workspaces/${localWorkspaceFolderBasename}/.devcontainer/echoes-lost-in-orbit_beginner/post-start.sh",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "manifests/appset.yaml"
      ]
    }
  },
  "forwardPorts": [
    30100
  ],
  "portsAttributes": {
    "30100": {
      "label": "ArgoCD",
      "onAutoForward": "notify"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "remoteEnv": {
    "OFFON_EXTERNAL_SOURCE": "dynatrace-community"
  }
}
